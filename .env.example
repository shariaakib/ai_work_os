# AI Work OS - Environment Configuration Template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git (it's already in .gitignore).

# --- AI API Key (required) ---
# Get a free key at https://openrouter.ai (sign up -> Keys -> Create)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# --- AI Model Settings (optional) ---
# AI_PROVIDER=openrouter        # openai, anthropic, openrouter
# AI_MODEL=openai/gpt-4o-mini   # Model to use via OpenRouter
# AI_TEMPERATURE=0.7            # 0.0 (deterministic) to 2.0 (creative)
# AI_MAX_TOKENS=4096            # Max tokens per response (1-8192)

# --- Verification (optional) ---
# VERIFICATION_ENABLED=true
# AUTO_FIX_THRESHOLD=0.8        # 0.0 to 1.0

# --- Logging (optional) ---
# LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
# LOG_FILE=logs/ai_work_os.log  # Leave empty for console-only

