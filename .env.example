# AI Work OS - Environment Configuration Template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git (it's already in .gitignore).

# --- AI API Key (required for live LLM) ---
# Get a free key at https://openrouter.ai (sign up -> Keys -> Create)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# --- Model (optional) ---
# Change this ONE value to swap models — no code edit or redeploy needed.
# Free-tier models end in ":free" and cost $0 (rate-limited). Examples:
#   meta-llama/llama-3.3-70b-instruct:free   (default, solid general use)
#   deepseek/deepseek-chat-v3.1:free
#   qwen/qwen3-coder:free
#   google/gemma-3-27b-it:free
# Paid examples: openai/gpt-4o-mini, anthropic/claude-3.5-haiku
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Sampling (optional) ---
# AI_TEMPERATURE=0.7     # 0.0 (deterministic) to 2.0 (creative)
# AI_MAX_TOKENS=4096     # Max tokens per response (1-8192)

# --- Runtime (optional) ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# PORT=8000
# DATA_DIR=data

